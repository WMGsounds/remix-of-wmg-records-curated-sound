{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/notion/tracks",
      "destination": "/api/notion/artists?dataset=tracks"
    },
    {
      "source": "/api/notion/catalogue",
      "destination": "/api/notion/artists?dataset=catalogue"
    },
    {
      "source": "/api/notion/gallery",
      "destination": "/api/notion/artists?dataset=gallery"
    },
    {
      "source": "/media/gallery/:galleryId/:filename",
      "destination": "/api/image-proxy?galleryId=:galleryId"
    },
    {
      "source": "/media/artists/:artistSlug/gallery/:index/:filename",
      "destination": "/api/image-proxy?artistSlug=:artistSlug&role=gallery&index=:index"
    },
    {
      "source": "/media/artists/:artistSlug/:role/:filename",
      "destination": "/api/image-proxy?artistSlug=:artistSlug&role=:role"
    },
    {
      "source": "/media/releases/:releaseKey/:filename",
      "destination": "/api/image-proxy?releaseKey=:releaseKey"
    },
    {
      "source": "/media/store/:storeKey/:filename",
      "destination": "/api/image-proxy?storeKey=:storeKey"
    },
    {
      "source": "/media/journal/:journalSlug/cover/:filename",
      "destination": "/api/image-proxy?journalSlug=:journalSlug"
    },
    {
      "source": "/media/journal/:journalSlug/images/:blockId/:filename",
      "destination": "/api/image-proxy?journalSlug=:journalSlug&blockId=:blockId"
    },
    {
      "source": "/api/media/release/:slug",
      "destination": "/api/image-proxy?releaseSlug=:slug"
    },
    {
      "source": "/seo-diagnostics",
      "destination": "/index.html"
    },
    {
      "source": "/media-library",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/spotify",
      "destination": "https://open.spotify.com/user/315vlgpfq47hf6pebgugkm6rbgxq",
      "permanent": true
    },
    {
      "source": "/artists/jack-rivers",
      "destination": "/artists",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "wmgsounds.com"
        }
      ],
      "destination": "https://www.wmgsounds.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "wmgr-soundscapes.lovable.app"
        }
      ],
      "destination": "https://www.wmgsounds.com/$1",
      "permanent": true
    }
  ]
}
