{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/notion/tracks",
      "destination": "/api/notion/artists?dataset=tracks"
    },
    {
      "source": "/api/notion/gallery",
      "destination": "/api/notion/artists?dataset=gallery"
    },
    {
      "source": "/api/media/release/:slug",
      "destination": "/api/image-proxy?releaseSlug=:slug"
    },
    {
      "source": "/((?!api/.*|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "wmgsounds.com"
        }
      ],
      "destination": "https://www.wmgsounds.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "wmgr-soundscapes.lovable.app"
        }
      ],
      "destination": "https://www.wmgsounds.com/$1",
      "permanent": true
    }
  ]
}
